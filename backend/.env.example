# ==============================================================================
# CONFIGURACIÓN GEMINI MULTIMODAL (AUDIO + IMÁGENES + TEXTO)
# ==============================================================================

# CUENTA 1: Primaria (Gemini 4 Hydrogen)
GEMINI_PRIMARY_KEY=tu_api_key_cuenta_1_aqui
GEMINI_PRIMARY_MODEL=gemini-4-hydrogen

# CUENTA 2: Fallback Automático (Gemini Flash / Pro)
GEMINI_FALLBACK_KEY=tu_api_key_cuenta_2_aqui
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Parámetros de generación (baja latencia y concisión)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=350

# Control de cuota mensual
MAX_MESSAGES_MONTH=1000

# WhatsApp Bridge
BACKEND_URL=http://localhost:8000/chat
LOG_LEVEL=error
